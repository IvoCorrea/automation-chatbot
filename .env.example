# Copie para .env e preencha. NUNCA versione o .env.
# Gere segredos com: openssl rand -hex 32   (e -hex 64 para o SECRET_KEY_BASE)

# =============================================================================
# Geral
# =============================================================================
# Dominio base. "localhost" usa a CA interna do Caddy (cert autoassinado).
# Um dominio real com DNS apontado liga o Let's Encrypt automaticamente.
BASE_DOMAIN=localhost
# E-mail para o registro ACME. Irrelevante quando BASE_DOMAIN=localhost.
ACME_EMAIL=
# Fuso usado por n8n, Postgres e agendamentos.
TZ=America/Sao_Paulo

# =============================================================================
# Postgres (um cluster, dois databases)
# =============================================================================
# Superusuario do cluster: usado apenas pelo init e por manutencao.
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=troque-me-superuser
# Database compartilhado pela aplicacao e pelo n8n.
APP_DB_NAME=app
# Role e schema da aplicacao (tabelas de leads, imoveis, etc).
APP_DB_USER=app
APP_DB_PASSWORD=troque-me-app
APP_DB_SCHEMA=core
# Role e schema do n8n dentro do mesmo database.
N8N_DB_USER=n8n
N8N_DB_PASSWORD=troque-me-n8n-db
N8N_DB_SCHEMA=n8n
# Database dedicado do Chatwoot (Rails exige schema public proprio).
CHATWOOT_DB_NAME=chatwoot
CHATWOOT_DB_USER=chatwoot
CHATWOOT_DB_PASSWORD=troque-me-chatwoot-db

# =============================================================================
# Redis (fila do Sidekiq/Chatwoot)
# =============================================================================
# Somente alfanumerico: a senha e interpolada dentro da REDIS_URL.
REDIS_PASSWORD=troquemeredis

# =============================================================================
# n8n
# =============================================================================
# Tag da imagem. Fixe uma versao antes de ir para producao.
N8N_VERSION=latest
# Chave que criptografa as credenciais salvas no n8n.
# ATENCAO: se mudar depois do primeiro boot, todas as credenciais ficam ilegiveis.
N8N_ENCRYPTION_KEY=troque-me-32-bytes-hex

# =============================================================================
# Chatwoot (inbox humana para handoff do corretor)
# =============================================================================
CHATWOOT_VERSION=latest
# Chave de sessao do Rails. Gere com: openssl rand -hex 64
CHATWOOT_SECRET_KEY_BASE=troque-me-64-bytes-hex
# Cadastro publico de contas: deixe false, a conta admin e criada no primeiro acesso.
CHATWOOT_ENABLE_ACCOUNT_SIGNUP=false
CHATWOOT_DEFAULT_LOCALE=pt_BR
# Preenchidos depois de criar a conta e a inbox na UI do Chatwoot;
# usados pelos workflows do n8n para transferir a conversa ao corretor.
CHATWOOT_API_ACCESS_TOKEN=
CHATWOOT_ACCOUNT_ID=
CHATWOOT_INBOX_ID=

# =============================================================================
# Provedores de LLM
# =============================================================================
# Usada tambem para gerar os embeddings de imoveis (text-embedding-3-small, 1536 dims).
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# =============================================================================
# WhatsApp Business API
# =============================================================================
# Qual provedor os workflows devem usar: 360dialog | meta
WHATSAPP_PROVIDER=360dialog

# --- 360dialog ---
# API key do numero (channel) no painel da 360dialog.
D360_API_KEY=
D360_API_BASE_URL=https://waba-v2.360dialog.io

# --- Meta Cloud API ---
# ID da conta WhatsApp Business.
META_WABA_ID=
# ID do numero de telefone que envia as mensagens.
META_PHONE_NUMBER_ID=
# Token permanente do system user com permissao whatsapp_business_messaging.
META_ACCESS_TOKEN=
# App secret, usado para validar a assinatura X-Hub-Signature-256 do webhook.
META_APP_SECRET=
# String arbitraria conferida pela Meta no handshake de verificacao do webhook.
META_VERIFY_TOKEN=

# =============================================================================
# Portas publicadas no host (perfil de dev, docker-compose.override.yml)
# =============================================================================
CADDY_HTTP_PORT=80
CADDY_HTTPS_PORT=443
POSTGRES_PORT=5432
REDIS_PORT=6379
N8N_PORT=5678
CHATWOOT_PORT=3000
# API Spring Boot (perfil de desenvolvimento).
API_PORT=8080
# Segredo compartilhado entre n8n e a API. Gere com: openssl rand -hex 32
API_INTERNAL_TOKEN=
